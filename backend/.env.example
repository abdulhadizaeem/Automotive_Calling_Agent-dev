# Retell (inbound voice)
# API key from Retell dashboard — use the key that shows a webhook badge (required for verify).
RETELL_API_KEY=

# Agent to use for inbound (optional override in call_inbound response).
RETELL_AGENT_ID=
# Optional pinned version for inbound override (integer string).
# RETELL_AGENT_VERSION=1

# Your published Retell number that customers dial (shown in assistant-initiate-call response).
RETELL_INBOUND_NUMBER=
# RETELL_PUBLIC_INBOUND_NUMBER=

# Map E.164 callee number (your Retell DID) -> user id (multi-tenant).
# RETELL_INBOUND_NUMBER_USER_MAP={"+15551234567":1}

# Single-tenant: all inbound calls attributed to this user if map lookup fails.
RETELL_DEFAULT_INBOUND_USER_ID=

# Optional: attach metadata.user_id on the Retell agent so webhooks resolve user without mapping.
# Set to false only for local testing (insecure).
# VERIFY_RETELL_WEBHOOK=true

# Production checklist (same as separate reference project, adapted):
# 1) Agent webhook URL: POST https://<host>/api/retell-webhook  (raw JSON; signature verified)
# 2) Inbound routing URL: POST https://<host>/api/retell-inbound-webhook  (event=call_inbound)
# 3) In Retell agent, enable webhook events: call_started, transcript_updated, call_ended, call_analyzed
#    (defaults often omit transcript_updated — enable it for live transcript in DB)
# 4) GET https://<host>/api/retell-health — verify env before go-live
#
# Note: Some codebases use HMAC(body, RETELL_WEBHOOK_SECRET); Retell's official verifier uses
# RETELL_API_KEY + X-Retell-Signature (implemented via retell-sdk). Do not mix patterns.
